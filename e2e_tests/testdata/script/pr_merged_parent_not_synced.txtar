# Test that av pr stops when the parent was merged on GitHub but av sync has not
# run, so the local metadata still says the parent's PR is open.
#
#     main:    X
#     stack-1:  \ -> 1a
#     stack-2:        \ -> 2a

exec av branch stack-1
commit-file my-file '1a\n' 'Commit 1a'
exec av branch stack-2
commit-file my-file '1a\n2a\n' 'Commit 2a'

set-branch-pr stack-1 nodeid-42 42 OPEN
mock-pull stack-1 42 MERGED HEAD

! exec av pr --title 'Add 2a' --body ''
stderr 'parent branch "stack-1" has already been merged'
stderr 'av sync'

# It should stop before pushing anything.
exec git ls-remote origin stack-2
! stdout .

# A branch that av doesn't track has no parent to check.
exec git checkout -b untracked main
commit-file other-file 'x\n' 'Commit x'
! exec av pr --title 'Add x' --body ''
stderr 'pushing to origin/untracked'
